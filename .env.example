# Copy this file to `.env` in the project root, then fill real values.
# After changing, rebuild the frontend: npm run build
#
# Deploy worker:
#   cd cloudflare-worker
#   npx wrangler login
#   npx wrangler d1 execute system-online-db --remote --file=./schema.sql
#   npx wrangler d1 execute system-online-db --remote --file=./schema-migrate-v2.sql
#   npx wrangler deploy
#
# Used by:
#   - Web: import.meta.env.VITE_CLOUDFLARE_WORKER_URL
#   - Electron: reads the same key from root .env
#
# WITHOUT a real worker URL, data stays in browser IndexedDB only
# and WILL BE LOST if the user clears site data.

# Required for permanent cloud backup (Cloudflare Worker + D1)
VITE_CLOUDFLARE_WORKER_URL=https://system-online-backend.YOUR_SUBDOMAIN.workers.dev

# NO API KEY IS NEEDED ANYMORE.
# The app authenticates with an HttpOnly session cookie that the Worker mints at
# POST /v1/session. It is established automatically, so cloud backup works with
# zero setup on any device — nothing to paste into the UI.
#
# Harden the Worker's cookie-signing secret in production:
#   cd cloudflare-worker && npx wrangler secret put SESSION_SECRET
#
# VITE_CLOUDFLARE_API_KEY is obsolete: it is no longer read by the app. (It was
# never safe anyway — VITE_* vars are inlined into the public JS bundle.)

# Optional public menu base URL for QR codes
# VITE_PUBLIC_MENU_URL=https://pos.engaz.tech/public-menu
