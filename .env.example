# Copy this file to `.env` in the project root, then fill real values.
# After changing, rebuild the frontend: npm run build
#
# Deploy worker:
#   cd cloudflare-worker
#   npx wrangler login
#   npx wrangler d1 execute system-online-db --remote --file=./schema.sql
#   npx wrangler d1 execute system-online-db --remote --file=./schema-migrate-v2.sql
#   npx wrangler deploy
#
# Used by:
#   - Web: import.meta.env.VITE_CLOUDFLARE_WORKER_URL / VITE_CLOUDFLARE_API_KEY
#   - Electron: reads the same keys from root .env
#
# WITHOUT a real worker URL, data stays in browser IndexedDB only
# and WILL BE LOST if the user clears site data.

# Required for permanent cloud backup (Cloudflare Worker + D1)
VITE_CLOUDFLARE_WORKER_URL=https://system-online-backend.YOUR_SUBDOMAIN.workers.dev

# API KEYS — do NOT put them here.
#
# The worker derives the caller's ROLE from which key it presents, so the keys
# decide what a device may do server-side. VITE_* variables are inlined into the
# public JavaScript bundle, so a key placed here would be readable by anyone who
# opens devtools — and on a cashier device that would leak manager rights.
#
# Enter them in the app instead: Settings -> Cloud Sync -> Sync Keys.
#   - Till / cashier device: cashier key only
#   - Manager device:        manager key
#
# Worker-side secrets (see cloudflare-worker/SECURITY-DEPLOY.md):
#   npx wrangler secret put MANAGER_API_KEY
#   npx wrangler secret put CASHIER_API_KEY
#   npx wrangler secret put REFUND_PIN

# Optional public menu base URL for QR codes
# VITE_PUBLIC_MENU_URL=https://pos.engaz.tech/public-menu
