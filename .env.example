# Copy this file to `.env` in the project root, then fill real values.
# After changing, rebuild the frontend: npm run build
#
# ─────────────────────────────────────────────────────────────────────────────
# The frontend needs exactly ONE variable: the Worker URL. Authentication is a
# credential-gated, HttpOnly session cookie minted by the Worker — NOT an API
# key. There is intentionally no VITE_*_API_KEY: a VITE_ variable is inlined
# into the public JS bundle, so shipping a key that way would expose it to every
# visitor. The operator signs in with the manager/cashier password; the browser
# hands that password to the Worker (POST /v1/session), the Worker verifies it
# against the PBKDF2 hashes in D1 and sets the session cookie.
# ─────────────────────────────────────────────────────────────────────────────

# Deploy / configure the Worker (see cloudflare-worker/README.md):
#   cd cloudflare-worker
#   npx wrangler login
#   npx wrangler d1 execute system-online-db --remote --file=./schema.sql
#   npx wrangler secret put SESSION_SECRET      # REQUIRED — signs session cookies
#   npx wrangler deploy
#   # then SEED the login credentials (breaks the first-run login deadlock):
#   MANAGER_PASSWORD='…' CASHIER_PASSWORD='…' node ../scripts/seed-manager-credential.mjs
#   npx wrangler d1 execute system-online-db --remote --file=../seed-credentials.sql
#
# WITHOUT a real worker URL, data stays in browser IndexedDB only
# and WILL BE LOST if the user clears site data.

# Required for permanent cloud backup (Cloudflare Worker + D1)
VITE_CLOUDFLARE_WORKER_URL=https://system-online-backend.YOUR_SUBDOMAIN.workers.dev

# Optional public menu base URL for QR codes
# VITE_PUBLIC_MENU_URL=https://pos.engaz.tech/public-menu
